{
  "openapi": "3.1.0",
  "info": {
    "title": "FAE Chat API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://TU_BACKEND"
    }
  ],
  "paths": {
    "/chat": {
      "post": {
        "operationId": "chatAssistant",
        "summary": "Enviar mensaje al asistente FAE",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "conversation_id": {
                    "type": "string"
                  },
                  "mode": {
                    "type": "string"
                  }
                },
                "required": [
                  "message"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta correcta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "response": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}